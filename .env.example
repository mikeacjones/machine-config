# Machine-local secrets for this repo. bootstrap.sh copies this file to .env
# (gitignored, mode 600) if it doesn't exist; fill in the values there.
#
# ~/.zshrc reads these each time `claude` or `claude2` runs and passes the token
# to that one process only. Nothing here is exported into your shell.

# Long-lived Claude Code tokens. Generate one per account with:
#   claude setup-token
#
# Primary account, used by `claude`. Leave empty to use the normal interactive
# login (`claude` then /login).
CLAUDE_OAUTH_TOKEN=

# Second account, used by `claude2`. It shares ~/.claude (settings, hooks,
# rules, history) with the primary account. If empty, `claude2` falls back to a
# macOS Keychain item named "claude2-oauth-token".
CLAUDE2_OAUTH_TOKEN=
